# {{AGENT_ID}} — 단독 실행(M1) 설정: cp .env.example .env
BIND_HOST=127.0.0.1
PORT=8001
UI_PORT=8081
# A2A 카드가 광고할 외부 주소(비우면 http://127.0.0.1:${PORT})
AGENT_PUBLIC_URL=
# 단독 실행 API 보호 키(/health·agent-card 외 x-api-key 필요). 비우면 무인증 — 로컬 시험 전용
AGENT_API_KEY=
# LLM: 플랫폼 게이트웨이(별칭) 또는 Ollama 직결(실제 모델명을 LLM_ALIAS 로)
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_ALIAS=llama3.2:3b
LLM_API_KEY=
