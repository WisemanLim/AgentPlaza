# wise-agentplaza — local 모드 (docker compose · SQLite). 시크릿 없음 → 커밋 가능 / no secrets, committable
APP_ENV=local
BIND_HOST=127.0.0.1
API_PORT=8010
REDIS_PORT=6390
DB_ENGINE=sqlite
DATABASE_URL=sqlite:////app/data/app.db
JWT_SECRET=local-dev-only-not-a-secret
AUTO_MIGRATE=true
OLLAMA_BASE_URL=http://host.docker.internal:11434
LLM_LOCAL_CHAT_MODEL=granite4.1:3b
LLM_LOCAL_REASONING_MODEL=qwen3:8b
# 퍼블릭 공급자 키(있을 때만 활성). 게이트웨이(api)만 보유 — 에이전트에는 주입하지 않는다(NFR-S3)
PUBLIC_MODELS=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# LLM 공급자 게이트웨이 엔진 Bifrost(PRD Q1) — api 는 이 주소로만 공급자를 부르고, 위 퍼블릭 키는 bifrost 서비스에만 주입된다
BIFROST_URL=http://bifrost:8080
# 런타임·게이트웨이 (Epic 7)
PLAZA_PROJECT=wise-agentplaza-local
GATEWAY_PORT=8090
RUNTIME_DRIVER=remote
RUNTIME_URL=http://runtime:9000
RUNTIME_TOKEN=local-runtime-token-not-a-secret
HITL_ALLOW_SELF_APPROVAL=true
PUBLIC_BASE_URL=http://127.0.0.1:8090
# OTel (D10-03): 플랫폼 스팬을 수집기로
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# Addon UI 전용 오리진(Traefik apps 진입점)
APPS_PORT=8092
PUBLIC_APPS_URL=http://127.0.0.1:8092
GATEWAY_INTERNAL_URL=http://traefik
# 거버넌스(D7-07 레이트리밋 카운터 · D9-04 시크릿 마스터 키 base64 32바이트, 비우면 JWT_SECRET 파생 — 로컬 전용)
REDIS_URL=redis://redis:6379/0
SECRETS_MASTER_KEY=
# 어시스턴트 확장(D1-07 임베딩·D3-04 비전 — 호스트 Ollama 모델, TEI_RERANK_URL 은 선택: compose-optional/tei.yml)
LLM_LOCAL_EMBED_MODEL=bge-m3
LLM_LOCAL_VISION_MODEL=qwen2.5vl:7b
TEI_RERANK_URL=
# 마켓 상거래·업데이트(D6-05·D6-07): 결제 어댑터 none(키 직접 입력만)|mock(실결제 없음) · 레지스트리 동기화·자동 갱신 주기(초, 0=끔)
PAYMENT_ADAPTER=mock
MARKET_SYNC_INTERVAL=3600
# 알림·상태(D10-07): 상태 변화 감시·알림 발송·주간 리포트 주기(초, 0=끔). 채널(Slack·Telegram·메일) 설정·비밀값은 콘솔(시크릿 저장소)
STATUS_CHECK_INTERVAL=60
# 호스티드 결제 어댑터(PRD Q6) — PAYMENT_ADAPTER=stripe|polar|lago 일 때만 주입(비우면 그 어댑터는 꺼짐). 시험 모드 키만, 비운영 실결제 금지
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRODUCT_ID=
POLAR_API_URL=https://sandbox-api.polar.sh
LAGO_API_URL=
LAGO_API_KEY=
LAGO_WEBHOOK_HMAC_KEY=
LAGO_ADD_ON_CODE=agentplaza_license
